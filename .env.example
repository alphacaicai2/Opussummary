# Smart defaults to authenticated administration; fill these before startup.
FEISHU_LOGIN_ENABLED=true
FEISHU_CLIENT_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://smart.example.com/auth/feishu/callback
# Optional allowlists (comma-separated); configure for your organisation.
FEISHU_ALLOWED_IDENTIFIERS=
FEISHU_ALLOWED_EMAIL_DOMAINS=
# If omitted, a session secret is generated in data/.web-session-secret.
FEISHU_SESSION_SECRET=
