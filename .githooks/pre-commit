from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def main() -> int:
    if os.environ.get("OPUS_SKIP_VERSION_BUMP") == "1":
        return 0

    repo_root = Path(__file__).resolve().parent.parent
    bump_script = repo_root / "tools" / "bump_version.py"

    subprocess.run(
        [sys.executable, str(bump_script)],
        check=True,
        cwd=str(repo_root),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(["git", "add", "VERSION"], check=True, cwd=str(repo_root))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
